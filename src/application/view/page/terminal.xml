<?xml version='1.0' encoding='utf-8'?>
<Window type="page" title="Omniport Code Terminal" background="#111827" font="mono" padding="1">
    <Row id="toolbar" align="center" justify="between" height="5">
        <Row align="center">
            <Input id="select" width="48" height="3" change="terminal:gg" placeholder="Seleziona un file" type="select">
            {% if terminal.files | result_success %}
            {% for item in terminal.files | result_value %}
                <Text>src/{{ item["relative_path"] }}</Text>
            {% endfor %}
            {% endif %}
            </Input>
            <Action id="stampa" width="10" height="3" margin="0,0,0,1" type="button" click="terminal:stampa"><Text>Path</Text></Action>
        </Row>
    </Row>
    <Group id="editors" type="tab" height="1fr">
        <Column id="application" width="1fr" padding="0,1">
            <Text type="h4" color="#93c5fd">Application</Text>
            <Input type="editor" language="python" id="editor-application" height="1fr">
                {% if terminal.editor.application | result_success %}{{ (terminal.editor.application | result_value)["content"] }}{% endif %}
            </Input>
            <Navigation type="tabs" height="5">
                {% for item in terminal.dependencies %}
                {% if item.startswith('src/application/') %}
                <Text value="{{ item }}">{{ item }}</Text>
                {% endif %}
                {% endfor %}
            </Navigation>
        </Column>
        <Column id="framework" width="1fr" padding="0,1">
            <Text type="h4" color="#86efac">Framework</Text>
            <Input type="editor" language="python" id="editor-framework" height="1fr">
                {% if terminal.editor.framework | result_success %}{{ (terminal.editor.framework | result_value)["content"] }}{% endif %}
            </Input>
            <Navigation type="tabs" height="5">
                {% for item in terminal.dependencies %}
                {% if item.startswith('src/framework/') %}
                <Text value="{{ item }}">{{ item }}</Text>
                {% endif %}
                {% endfor %}
            </Navigation>
        </Column>
        <Column id="infrastructure" width="1fr" padding="0,1">
            <Text type="h4" color="#fcd34d">Infrastructure</Text>
            <Input type="editor" language="python" id="editor-infrastructure" height="1fr">
                {% if terminal.editor.infrastructure | result_success %}{{ (terminal.editor.infrastructure | result_value)["content"] }}{% endif %}
            </Input>
            <Navigation type="tabs" height="5">
                {% for item in terminal.dependencies %}
                {% if item.startswith('src/infrastructure/') %}
                <Text value="{{ item }}">{{ item }}</Text>
                {% endif %}
                {% endfor %}
            </Navigation>
        </Column>
    </Group>
</Window>