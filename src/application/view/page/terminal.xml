<?xml version='1.0' encoding='utf-8'?>
<Window type="page" title="Omniport Code Terminal" background="#111827" font="mono" padding="1">
    {% macro editor_language(filename) -%}{% set path = (filename or '') | lower %}{% if path.endswith('.py') or path.endswith('.dsl') %}python{% elif path.endswith('.xml') %}xml{% elif path.endswith('.json') %}json{% elif path.endswith('.toml') %}toml{% elif path.endswith('.md') %}markdown{% else %}markdown{% endif %}{%- endmacro %}
    <Row id="toolbar" align="center" justify="between" height="5">
            <Input id="select" height="3" value="{{ terminal.select }}" change="terminal:select" placeholder="Seleziona un file" type="select">
            {% if terminal.files | check %}
            {% for item in terminal.files | value %}
                <Text>{{ item["relative_path"] }}</Text>
            {% endfor %}
            {% endif %}
            </Input>
            <Action id="stampa" width="10" height="3" margin="0,0,0,1" type="button" click="terminal:stampa"><Text>Path</Text></Action> 
    </Row>
    <Group id="editors" type="tab" height="1fr">
        <Column id="application" width="1fr" padding="0,1">
            <Group id="editors" type="tab" height="1fr">
                <Input type="editor" language="{{ editor_language(terminal.select_application) }}" id="file" height="1fr">
                    {% if terminal.editor.application | check %}
                    <Storekeeper
                        id="files"
                        operation="gather"
                        repository="file"
                        filter='{{ {"eq": {"filename": terminal.select_application}} | tojson }}'
                    >
                        <Text>{{ store.files.content }}</Text>
                    </Storekeeper>
                    {% endif %}
                </Input>
                <Input type="editor" language="{{ editor_language(terminal.select_application) }}" id="test" height="1fr">
                    {% if terminal.editor.application | check %}
                    <Text>{{ terminal.editor.application | value | get("content") | e }}</Text>
                    {% endif %}
                </Input>
                <Input type="editor" language="{{ editor_language(terminal.select_application) }}" id="contract" height="1fr">
                    {% if terminal.editor.application | check %}
                    <Text>{{ terminal.editor.application | value | get("content") | e }}</Text>
                    {% endif %}
                </Input>
            </Group>
            <Navigation type="tabs" height="5">
                {% for item in terminal.application_files %}
                <Text click="terminal:select_application">{{ item }}</Text>
                {% endfor %}    
            </Navigation>
        </Column>
        <Column id="framework" width="1fr" padding="0,1">
            <Group id="editors" type="tab" height="1fr">
                <Input type="editor" language="{{ editor_language(terminal.select_framework) }}" id="file" height="1fr">
                    {% if terminal.editor.framework | check %}
                    <Storekeeper
                        id="files"
                        operation="gather"
                        repository="file"
                        filter='{{ {"eq": {"filename": terminal.select_framework}} | tojson }}'
                    >
                        <Text>{{ store.files.content }}</Text>
                    </Storekeeper>
                    {% endif %}
                </Input>
                <Input type="editor" language="{{ editor_language(terminal.select_application) }}" id="test" height="1fr">
                    <Storekeeper
                        id="files"
                        operation="gather"
                        repository="file"
                        filter='{{ {"eq": {"filename": terminal.select_framework}} | tojson }}'
                    >
                        <Text>{{ store.files.content }}</Text>
                    </Storekeeper>
                </Input>
                <Input type="editor" language="{{ editor_language(terminal.select_application) }}" id="contract" height="1fr">
                    <Storekeeper id="files" operation="gather" repository="file" filter='{{ {"eq": {"filename": terminal.select_framework}} | tojson }}' >
                        <Text>{{ store.files.content }}</Text>
                    </Storekeeper>
                </Input>
            </Group>
            <Navigation type="tabs" height="5" value="{{terminal.select_framework}}">
                {% for item in terminal.framework_files %}
                <Action click="terminal:select_framework" ><Text>{{ item }}</Text></Action>
                {% endfor %}    
            </Navigation>
        </Column>
        <Column id="infrastructure" width="1fr" padding="0,1">
            <Group id="editors" type="tab" height="1fr">
                <Input type="editor" language="{{ editor_language(terminal.select_infrastructure) }}" id="file" height="1fr">
                    <Storekeeper id="files" operation="gather" repository="file" filter='{{ {"eq": {"filename": terminal.select_infrastructure}} | tojson }}'>
                        <Text>{{ store.files.content }}</Text>
                    </Storekeeper>
                </Input>
                <Input type="editor" language="{{ editor_language(terminal.select_infrastructure) }}" id="test" height="1fr">
                    <Storekeeper id="files" operation="gather" repository="file" filter='{{ {"eq": {"filename": terminal.select_infrastructure}} | tojson }}'>
                        <Text>{{ store.files.content }}</Text>
                    </Storekeeper>
                </Input>
                <Input type="editor" language="{{ editor_language(terminal.select_infrastructure) }}" id="contract" height="1fr">
                    <Storekeeper id="files" operation="gather" repository="file" filter='{{ {"eq": {"filename": terminal.select_infrastructure}} | tojson }}' >
                        <Text>{{ store.files.content }}</Text>
                    </Storekeeper>
                </Input>
            </Group>
            <Navigation type="tabs" height="5">
                {% for item in terminal.infrastructure_files %}
                <Action click="terminal:select_infrastructure" ><Text>{{ item }}</Text></Action>
                {% endfor %}
            </Navigation>
        </Column>
    </Group>
</Window>