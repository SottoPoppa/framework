<Window id="{{ component.id }}" type="modal" title="New Task">
    <Column padding="1px" spacing="1px">
        <Input id="task-title" type="text" name="title" placeholder="Task title" required="true" />
        <Input id="task-description" type="textarea" name="description" placeholder="Description" />
        <Input id="task-file" type="select" name="file" value="{{ component.attributes.default_file }}" placeholder="Main file (optional)">
            <Option value="__none__" title="No file" />
            {{ component.inner | safe }}
        </Input>
        <Input id="task-priority" type="select" name="priority" value="medium">
            <Option value="low" /><Option value="medium" /><Option value="high" /><Option value="critical" />
        </Input>
        <Action id="create-task" type="button" click="kanban:create_task" form="new-task-dialog" color="#ffffff"><Text>Create task</Text></Action>
    </Column>
</Window>