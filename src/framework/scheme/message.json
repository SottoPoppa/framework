{
  "type": {
    "type": "string",
    "required": true,
    "allowed": ["redis", "rabbitmq", "kafka", "event_bus", "activemq", "sqs"]
  },
  "url": {
    "type": "string",
    "required": true,
    "regex": "^(rediss?|amqps?|kafka|https?)://.*"
  },
  "tls": {
    "type": "dict",
    "required": true,
    "schema": {
      "enabled": { "type": "boolean", "required": true },
      "verify_cert": { "type": "boolean", "required": true },
      "min_version": { "type": "string", "required": false, "allowed": ["TLSv1.2", "TLSv1.3"] },
      "ca_cert_path": { "type": "string", "nullable": true, "required": false },
      "client_cert_path": { "type": "string", "nullable": true, "required": false },
      "client_key_path": { "type": "string", "nullable": true, "required": false }
    }
  },
  "authentication": {
    "type": "dict",
    "required": true,
    "schema": {
      "mechanism": {
        "type": "string",
        "required": true,
        "allowed": ["none", "basic", "sasl_plain", "sasl_scram_sha_512", "mtls", "oauth2", "iam_role"]
      },
      "username": { "type": "string", "nullable": true, "required": false },
      "password_secret_ref": { "type": "string", "nullable": true, "required": false },
      "token_endpoint": { "type": "string", "nullable": true, "required": false }
    }
  },
  "authorization": {
    "type": "dict",
    "required": false,
    "schema": {
      "role": {
        "type": "string",
        "required": true,
        "allowed": ["admin", "publisher", "subscriber", "read_only"]
      },
      "allowed_topics_patterns": {
        "type": "list",
        "required": false,
        "schema": { "type": "string" }
      },
      "allowed_queues_patterns": {
        "type": "list",
        "required": false,
        "schema": { "type": "string" }
      }
    }
  },
  "data_protection": {
    "type": "dict",
    "required": false,
    "schema": {
      "payload_encryption_enabled": { "type": "boolean", "required": true },
      "algorithm": {
        "type": "string",
        "required": false,
        "allowed": ["AES-256-GCM", "ChaCha20-Poly1305"]
      },
      "key_rotation_days": { "type": "integer", "min": 1, "required": false }
    }
  },
  "rate_limiting_and_quotas": {
    "type": "dict",
    "required": false,
    "schema": {
      "max_connections": { "type": "integer", "min": 1, "required": false },
      "max_msg_size_bytes": { "type": "integer", "min": 1024, "required": false },
      "max_publish_rate_per_sec": { "type": "integer", "min": 1, "required": false }
    }
  },
  "secrets_management": {
    "type": "dict",
    "required": false,
    "schema": {
      "provider": {
        "type": "string",
        "required": true,
        "allowed": ["env_var", "hashicorp_vault", "aws_secrets_manager", "azure_key_vault", "k8s_secret"]
      },
      "vault_path": { "type": "string", "nullable": true, "required": false }
    }
  },
  "audit_logging": {
    "type": "dict",
    "required": false,
    "schema": {
      "enabled": { "type": "boolean", "required": true },
      "log_failed_auth_attempts": { "type": "boolean", "required": true },
      "log_data_access": { "type": "boolean", "required": false }
    }
  },
  "network_security": {
    "type": "dict",
    "required": false,
    "schema": {
      "allowed_cidrs": {
        "type": "list",
        "required": false,
        "schema": {
          "type": "string",
          "regex": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[1-2][0-9]|3[0-2])$"
        }
      },
      "use_private_link": { "type": "boolean", "required": false }
    }
  },
  "encryption_at_rest": {
    "type": "dict",
    "required": false,
    "schema": {
      "enabled": { "type": "boolean", "required": true },
      "kms_key_id": { "type": "string", "nullable": true, "required": false }
    }
  }
}